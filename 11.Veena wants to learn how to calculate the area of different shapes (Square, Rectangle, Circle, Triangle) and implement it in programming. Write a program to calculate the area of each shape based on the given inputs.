a = int(input())
l = int(input())
b = int(input())
r = int(input())
B = int(input())
h = int(input())

square = a * a
rectangle = l * b
circle = 3.14 * r * r
triangle = 0.5 * B * h

print("Area of Square=", square, sep="")
print("Area of Rectangle=", rectangle, sep="")
print("Area of Circle={:.2f}".format(circle))
print("Area of Triangle=", int(triangle) if triangle.is_integer() else triangle, sep="")
